# ORDER INTAKE (Phase 1). All five below must be set for checkout to send;
# with any missing, the API answers "unconfigured" and the cart hands the
# visitor the phone number and a prefilled mailto instead. Honest either way.
#
# Mail is SMTP through a real mailbox, per glaze.md. Until DeVine's signs and
# hands over a mailbox, use a glazedweb.com mailbox and point ORDER_TO at
# Glazed, so a stray order on the pitch host reaches a person. On launch day
# ORDER_TO becomes the shop's inbox. That flip is an env edit, not a deploy.
#
# Secrets are set in the Vercel dashboard by Kevin. Never in a file.

SMTP_HOST=
# 465 assumed if unset (implicit TLS). 587 also works; STARTTLS is inferred.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Where the shop's ticket lands. THE inbox to confirm before calling this live:
# glaze.md launch bar is "every form actually submitted and confirmed arriving
# in a real inbox."
ORDER_TO=

# Optional. From-address on both emails; defaults to SMTP_USER.
ORDER_FROM=

# WORKROOM (Phase 2). The order board and stem tracker at /workroom.
#
# Without a database the workroom runs on in-memory storage: fine locally,
# lossy on deployed serverless (entries live per-lambda), and the pages say so
# in a visible warning. Create one in Vercel: project > Storage > Create
# Database > Neon, free tier. Tables create themselves on first use.
DATABASE_URL=

# The workroom PIN. **REQUIRED IN PRODUCTION — without it /workroom simply
# does not open**, and the login page says so.
#
# It used to fall back to the shop phone's last four so the demo needed no
# setup. A review killed that: the fallback is committed to this repo AND
# printed in the site footer, and behind the gate sit customer names, phones,
# delivery addresses and card messages. An unset variable now closes the door
# instead of fitting a known lock. The fallback survives for `next dev` only.
#
# Pick four digits that are NOT the phone number. Login is throttled to 10
# wrong tries per 10 minutes per IP.
WORKROOM_PIN=

# SQUARE (the register link). The shop already rings sales on Square; this
# link pushes our catalog onto her register (POST /api/square/sync, workroom
# PIN) and ingests every completed payment back (/api/square/webhook) so the
# workroom sees counter sales without anyone retyping them.
#
# SANDBOX FIRST. Getting sandbox credentials, once, by Kevin:
#   1. developer.squareup.com > sign in > create an application (any name).
#   2. The app's Credentials page has a Sandbox/Production toggle. On SANDBOX:
#      copy the Sandbox Access Token into SQUARE_ACCESS_TOKEN.
#   3. Sandbox test accounts > open the Default Test Account > Locations:
#      copy the location id into SQUARE_LOCATION_ID.
#   4. The app's Webhooks page, still on Sandbox: add a subscription pointing
#      at https://<this deployment>/api/square/webhook, subscribe to
#      payment.created and payment.updated, then copy the subscription's
#      Signature Key into SQUARE_WEBHOOK_SIGNATURE_KEY and the exact URL you
#      typed into SQUARE_WEBHOOK_URL (the signature covers the URL, so the
#      two must match to the character).
# Production is the OWNER's Square account connected via OAuth through the
# Glazed platform app (next block), plus SQUARE_ENV=production. Until that
# word is set, everything talks to the sandbox: a typo cannot reach the shop.

SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# THE GLAZED PLATFORM APP (OAuth + the platform fee). One app, owned by the
# GLAZED Square developer account (kevin@glazedweb.com), authorized by the
# shop's own account. This is the only token type that can carry
# app_fee_money, the per-order platform fee, which accrues to the Glazed
# account. Her plan does not matter: the free plan has full API access.
#
# Getting these, once, by Kevin at developer.squareup.com. The app is named
# "devine" (created 2026-08-31; one app per client, since an app holds one
# redirect URL per environment):
#   1. BOTH values live on the app's OAuth page (left sidebar), NOT the
#      Credentials page, and the page has the same Sandbox/Production toggle
#      as above: Application ID -> SQUARE_APP_ID, Application Secret ->
#      SQUARE_APP_SECRET. The Credentials page shows an Access Token in the
#      secret's place, and pasting THAT as the secret is the trap that cost
#      the first connect attempt a 401 on oauth2/token: the permission
#      screen works, Allow works, and the exchange dies. Landing back on
#      /workroom?square=failed with a clean-looking flow means check this
#      first.
#   2. The app's OAuth page, same toggle: set the Redirect URL to EXACTLY
#      https://<this deployment>/api/square/oauth/callback
#      Square never receives the URL in a request; the dashboard string IS
#      the redirect, so there is nothing else to keep in sync.
#   3. Connecting the owner: she (or Kevin on her machine) signs into the
#      workroom, then visits /api/square/connect. Square asks HER account
#      to approve; the callback stores the grant in Neon (memory storage
#      refuses, and says why). /api/square/sync GET reports the connection.
# With a grant stored, SQUARE_ACCESS_TOKEN above is no longer consulted;
# it remains the sandbox and local-dev path.

SQUARE_APP_ID=
SQUARE_APP_SECRET=

# Cents, added to online card payments as the platform fee when they exist
# (dormant until the site takes cards at all; see lib/square/payments.ts).
# Unset means 99, the portfolio-standard fee. 0 disables.
SQUARE_APP_FEE_CENTS=

# Literally "production" or absent. Anything else means sandbox.
SQUARE_ENV=

# Optional Square-Version header. Unset, the app's dashboard-pinned API
# version governs (current, for a new app). Pin once the integration proves.
SQUARE_VERSION=
